{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parano1d.org/ecosystem.schema.json",
  "title": "Parano1d links directory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories", "projects"],
  "properties": {
    "version": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 48
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 180
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "name", "description", "maintainer", "url", "source", "tags"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 72
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 220
          },
          "maintainer": {
            "type": "string",
            "minLength": 2,
            "maxLength": 72
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 320
          },
          "supportUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 320
          },
          "source": {
            "enum": ["open", "closed", "not-applicable"]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9 .+/-]*$",
              "maxLength": 24
            }
          }
        }
      }
    }
  }
}
